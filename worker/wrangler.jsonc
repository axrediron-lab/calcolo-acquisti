{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "calcolo-acquisti-api",
  "main": "src/index.js",
  "compatibility_date": "2026-09-02",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "triggers": {
    "crons": ["30 17 * * 1-5"]
  },
  "d1_databases": [
    {
      "binding": "PURCHASES_DB",
      "database_name": "calcolo-acquisti-archivio",
      "database_id": "a3db68b5-5ff4-486c-be22-3040aa013873",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "DRIVE_FOLDER_ID": "1p46QtfodU6g8piuuuUY5F0Z3GeuOZ_HZ",
    "DRIVE_FILE_NAME": "acquisti.CSV",
    "DRIVE_SERVICE_ACCOUNT_EMAIL": "importazione-acquisti@liquid-agility-466309-f5.iam.gserviceaccount.com",
    "BACKMARKET_API_BASE": "https://www.backmarket.fr",
    "BACKMARKET_USER_AGENT": "Axrediron",
    "BACKMARKET_ACCEPT_LANGUAGE": "it-it",
    "ALLOWED_ORIGINS": "https://axrediron-lab.github.io,http://localhost:8000,http://127.0.0.1:8000"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.05
    }
  }
}
